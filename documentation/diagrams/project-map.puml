@startuml
top to bottom direction
skinparam shadowing false
skinparam linetype ortho

skinparam folder {
  BackgroundColor<<root>> yellow
  BackgroundColor<<api only>> olive
  BackgroundColor<<impl. detail>> white
  BackgroundColor<<test support>> lightgray
  BackgroundColor<<tool>> lightblue
}

folder "utils" <<root>>
folder "core"
folder "unify"
folder "theory"
folder "datalog"
folder "bdd"

folder "dsl-core" as DC
folder "dsl-unify" as DU
folder "dsl-theory" as DT
folder "dsl-solve" as DS

folder "solve" <<api only>>
folder "solve-classic" as SC
folder "solve-streams" as SS
folder "solve-concurrent" as SCON
folder "solve-plp" as SPLP
folder "solve-problog" as SPL

folder "parser-core" as PC
folder "parser-impl" <<impl. detail>> as PI
folder "parser-theory" as PT

folder "serialize-core" as SRC
folder "serialize-theory" as SRT

folder "test-solve" <<test support>> as TS
folder "test-dsl" <<test support>> as TD

folder "oop-lib" as OOP
folder "io-lib" as IO

' All modules physically living under ui/ in the repo, grouped together.
package "ui" {
  folder "repl" <<tool>>
  folder "gui" as GUI
  folder "gui-plp" as GPLP
  folder "ide-swing" <<tool>> as IDESW
  folder "ide-plp-swing" <<tool>> as IDEPLPSW
  folder "ide-web" <<tool>> as IDEWEB
}

folder "examples" <<tool>>
folder "full" <<tool>>

' Edges below are a transitive reduction: only direct dependencies not already implied
' by another shown path are drawn (e.g. solve -> theory is enough, since theory already
' implies unify and core).

' -- Foundation --
utils <|-down- core

' -- Unification & theories --
core <|-down- unify
unify <|-down- theory
theory <|-down- datalog

' -- Kotlin DSL --
core <|-down- DC
DC <|-down- DU
unify <|-down- DU
DU <|-down- DT
theory <|-down- DT
DT <|-down- DS

' -- Resolution (solve) --
theory <|-down- solve
solve <|-down- SC
DT <|-down- SC
solve <|-down- SS
DT <|-down- SS
solve <|-down- SCON
DT <|-down- SCON
solve <|-down- SPLP
bdd <|-down- SPLP
SC <|-down- SPL
SPLP <|-down- SPL

' -- Parsing --
core <|-down- PC
PI <|-down- PC : uses
theory <|-down- PT
PC <|-down- PT

' -- Serialization --
core <|-down- SRC
theory <|-down- SRT
SRC <|-down- SRT

' -- Test-support modules (consumed from `commonTest`, not from `commonMain`) --
solve <|-down- TS : test dep. of
DT <|-down- TS : test dep. of
DC <|-down- TD : test dep. of

' -- Libraries --
solve <|-down- OOP
solve <|-down- IO
PT <|-down- IO

' -- UI toolkit & apps (ui/) --
OOP <|-down- "repl"
IO <|-down- "repl"
SC <|-down- "repl"

IO <|-down- GUI
OOP <|-down- GUI

GUI <|-down- GPLP
SPLP <|-down- GPLP

GUI <|-down- IDESW
SC <|-down- IDESW

GPLP <|-down- IDEPLPSW
IDESW <|-down- IDEPLPSW
SPL <|-down- IDEPLPSW

GUI <|-down- IDEWEB
SC <|-down- IDEWEB

' -- Tools --
SCON <|-down- "examples"
SPL <|-down- "examples"
IO <|-down- "examples"
OOP <|-down- "examples"

note bottom of TS
  **test-solve** and **test-dsl** are reusable
  test suites, consumed from other modules'
  ""commonTest"" source set, not from their
  main/api dependencies (so they never
  appear as regular runtime dependencies).
end note

note bottom of "full"
  **full** aggregates (depends on)
  every other module, as a
  batteries-included single artifact.
end note
@enduml
