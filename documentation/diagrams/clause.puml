@startuml
left to right direction
skinparam shadowing false

interface Struct

interface Clause {
  + head: Compound?
  + body: Term
  + isWellFormed: Boolean
  + {static} of(head: Compound?, **varargs** body: Term): Clause
}
interface Rule {
  + head: Compound
  + body: Term
  + {static} of(head: Compound, **varargs** body: Term): Rule
}
interface Goal {
  + head: Nothing? **= null**
  + {static} of(**varargs** body: Term): Goal
}
interface Fact {
  + body: Term **= Truth.of(true)**
  + {static} of(head: Compound): Fact
}
Struct <|-- Clause
Clause <|-- Rule
Clause <|-- Goal
Rule <|-- Fact
@enduml